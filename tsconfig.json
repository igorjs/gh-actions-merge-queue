{
  "compilerOptions": {
    "types": ["vitest/globals"],
    "lib": ["ES2024"],
    "target": "ES2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "node_modules",
    "dist",
    "vitest.config.ts"
  ]
}
