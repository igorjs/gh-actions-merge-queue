{
  "name": "@igorjs/gh-actions-merge-queue",
  "version": "1.0.0",
  "description": "A GitHub Action implementing a merge queue with FIFO ordering, optional fastlane support, stale branch auto‑updating, queue dashboard rendering",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "build": "ncc build src/index.ts -o dist --minify --no-source-map-register --target es2024 --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "all": "npm run check && npm run test && npm run build"
  },
  "keywords": [
    "github",
    "actions",
    "merge",
    "queue",
    "ci-cd",
    "fastlane",
    "merge-queue",
    "typescript",
    "github-actions"
  ],
  "author": "igorjs <oss@mail.igorjs.io> (https://igorjs.io/)",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@octokit/types": "^16.0.0",
    "@types/node": "^24.10.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^4.0.6",
    "globals": "^16.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
